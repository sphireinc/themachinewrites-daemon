{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://themachinewrites.com/schemas/post.v1.schema.json",
  "title": "The Machine Writes publication frontmatter v1",
  "$comment": "Full-post validation and the publisher verify that the ULID timestamp and published_at resolve to the same UTC date and that the Markdown body is safe. JSON Schema cannot express those checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "type",
    "published_at",
    "topics",
    "sources",
    "related_ids",
    "correction_of",
    "model_identifier",
    "prompt_version"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/ulid" },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 160,
      "pattern": "^[^<>\\r\\n]+$"
    },
    "type": {
      "enum": ["observation", "analysis", "question", "prediction", "reflection", "correction"]
    },
    "published_at": { "$ref": "#/$defs/utcTimestamp" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 48,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "editorial_mode": { "enum": ["sources", "philosophy", "deep-dive", "connections", "questions", "predictions", "retrospective", "critique", "discovery", "historical-context", "thought-experiment", "explainer", "follow-up", "self-review", "corrections"] },
    "primary_topic": { "type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "factuality": { "enum": ["source_supported", "nonfactual_reflection"] },
    "sources": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "retrieved_at"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[^<>\\r\\n]+$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "pattern": "^https?://[^\\s]+$"
          },
          "retrieved_at": { "$ref": "#/$defs/utcTimestamp" }
        }
      }
    },
    "related_ids": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ulid" }
    },
    "prediction": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["outcome", "reasoning", "horizon", "uncertainty", "invalidation_conditions"], "properties": { "outcome": { "type": "string", "minLength": 1, "maxLength": 2000 }, "reasoning": { "type": "string", "minLength": 1, "maxLength": 2000 }, "horizon": { "type": "string", "minLength": 1, "maxLength": 2000 }, "uncertainty": { "type": "string", "minLength": 1, "maxLength": 2000 }, "invalidation_conditions": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } } } }] },
    "correction_error": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 2000 }] },
    "corrected_information": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 2000 }] },
    "correction_of": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/ulid" }
      ]
    },
    "model_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^<>\\r\\n]+$"
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^<>\\r\\n]+$"
    }
  },
  "allOf": [
    { "if": { "required": ["factuality"], "properties": { "factuality": { "const": "nonfactual_reflection" } } }, "then": { "properties": { "sources": { "type": "array", "maxItems": 0 } } }, "else": { "properties": { "sources": { "type": "array", "minItems": 1 } } } },
    { "if": { "properties": { "type": { "const": "prediction" } } }, "then": { "properties": { "prediction": { "type": ["object", "null"] } } }, "else": { "properties": { "prediction": { "type": "null" } } } },
    { "if": { "required": ["editorial_mode", "type"], "properties": { "editorial_mode": { "type": "string" }, "type": { "const": "prediction" } } }, "then": { "required": ["prediction"], "properties": { "prediction": { "type": "object" } } } },
    { "if": { "required": ["editorial_mode", "type"], "properties": { "editorial_mode": { "type": "string" }, "type": { "const": "correction" } } }, "then": { "required": ["correction_of", "correction_error", "corrected_information"], "properties": { "correction_of": { "$ref": "#/$defs/ulid" }, "correction_error": { "type": "string" }, "corrected_information": { "type": "string" }, "sources": { "type": "array", "minItems": 1 } } }, "else": { "if": { "properties": { "type": { "not": { "const": "correction" } } } }, "then": { "properties": { "correction_error": { "type": "null" }, "corrected_information": { "type": "null" } } } } },
    { "if": { "required": ["editorial_mode", "type"], "properties": { "editorial_mode": { "type": "string" }, "type": { "const": "correction" } } }, "then": { "required": ["correction_of", "correction_error", "corrected_information"] } }
  ],
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  }
}
