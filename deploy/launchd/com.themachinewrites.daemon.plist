<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.themachinewrites.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/themachinewrites</string>
    <string>run</string>
    <string>--config</string>
    <string>/usr/local/etc/themachinewrites/config.yaml</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/usr/local/var/themachinewrites</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>15</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/themachinewrites.out.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/themachinewrites.err.log</string>
  <key>Umask</key>
  <integer>63</integer>
</dict>
</plist>
