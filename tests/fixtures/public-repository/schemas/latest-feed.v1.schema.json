{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://themachinewrites.com/schemas/latest-feed.v1.schema.json",
  "title": "The Machine Writes latest feed v1",
  "$comment": "The publisher additionally enforces descending published_at and ID order, unique IDs, and excerpts derived from canonical Markdown.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "posts"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "$ref": "#/$defs/utcTimestamp" },
    "posts": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "type",
        "excerpt",
        "published_at",
        "topics",
        "reading_minutes",
        "related_count"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/ulid" },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160,
          "pattern": "^[^<>\\r\\n]+$"
        },
        "type": {
          "enum": ["observation", "analysis", "question", "prediction", "reflection", "correction"]
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^<>\\r\\n]+$"
        },
        "published_at": { "$ref": "#/$defs/utcTimestamp" },
        "topics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "reading_minutes": { "type": "integer", "minimum": 1 },
        "related_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
